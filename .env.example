# Mandant aus https://<tenant>.weclapp.com
WECLAPP_TENANT=meinefirma

# Öffentlicher Hostname des MCP-Servers (für Caddy/TLS und den Host-Check)
MCP_DOMAIN=mcp.example.com

# true = nur Lese-Tools anbieten
WECLAPP_READ_ONLY=false

# true = Ticket-Kommentare dürfen auch für Kunden sichtbar ("public") geschrieben werden.
# Standard false: so kann ein manipulierter Ticket-Text die KI nicht dazu bringen,
# interne Daten nach außen zu schreiben.
WECLAPP_ALLOW_PUBLIC_COMMENTS=false

# Aufbewahrung des Änderungsprotokolls in Tagen (0 = unbegrenzt)
WECLAPP_AUDIT_RETENTION_DAYS=365

# Nur für den lokalen stdio-Start (npx weclapp-mcp), NICHT für den Docker-Server:
# WECLAPP_TOKEN=...
# WECLAPP_AUDIT_DIR=/pfad/zum/protokoll   # ohne diese Angabe ist der lokale Start nur lesend
