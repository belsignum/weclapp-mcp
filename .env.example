# Mandant aus https://<tenant>.weclapp.com
WECLAPP_TENANT=meinefirma

# Öffentlicher Hostname des MCP-Servers (für Caddy/TLS und den Host-Check)
MCP_DOMAIN=mcp.example.com

# --- Nur für den Betrieb hinter einem vorhandenen NGINX (docker-compose.nginx.yml, siehe DEPLOY.md) ---
# Damit "docker compose ..." ohne -f die richtige Datei nimmt (und nicht die Caddy-Variante):
# COMPOSE_FILE=docker-compose.nginx.yml
# Port, an den das NGINX weiterleitet. Der Container lauscht nur auf 127.0.0.1:<MCP_PORT>.
# MCP_PORT=8734
# true nur, wenn das NGINX X-Forwarded-For selbst setzt oder ergänzt (DEPLOY.md, Schritt 4).
# MCP_TRUST_PROXY=false

# true = nur Lese-Tools anbieten
WECLAPP_READ_ONLY=false

# true = Ticket-Kommentare dürfen auch für Kunden sichtbar ("public") geschrieben werden.
# Standard false: so kann ein manipulierter Ticket-Text die KI nicht dazu bringen,
# interne Daten nach außen zu schreiben.
WECLAPP_ALLOW_PUBLIC_COMMENTS=false

# Aufbewahrung des Änderungsprotokolls in Tagen (0 = unbegrenzt)
WECLAPP_AUDIT_RETENTION_DAYS=365

# Maximale Größe des Änderungsprotokolls in MB (0 = unbegrenzt). Ist sie erreicht, lehnt der Server
# Schreibaktionen ab, bis alte Monatsdateien ablaufen oder der Wert erhöht wird.
WECLAPP_AUDIT_MAX_MB=100

# Höchstzahl an Schreibaktionen pro Nutzer und Stunde (0 = unbegrenzt). Bremst Massenänderungen,
# etwa durch einen manipulierten Ticket-Text oder einen Agenten in einer Schleife.
# Für größere geplante Sammeländerungen vorübergehend erhöhen.
WECLAPP_MAX_WRITES_PER_HOUR=120

# Nur für den lokalen stdio-Start (npx weclapp-mcp), NICHT für den Docker-Server:
# WECLAPP_TOKEN=...
# WECLAPP_AUDIT_DIR=/pfad/zum/protokoll   # ohne diese Angabe ist der lokale Start nur lesend
