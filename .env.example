# Mandant aus https://<tenant>.weclapp.com
WECLAPP_TENANT=meinefirma

# Öffentlicher Hostname des MCP-Servers (für Caddy/TLS und den Host-Check)
MCP_DOMAIN=mcp.example.com

# true = nur Lese-Tools anbieten
WECLAPP_READ_ONLY=false

# Nur für den lokalen stdio-Start (npx weclapp-mcp), NICHT für den Docker-Server:
# WECLAPP_TOKEN=...
