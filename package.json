{
  "name": "weclapp-mcp",
  "version": "0.1.0",
  "description": "MCP-Server für weclapp: Artikel, Rechnungen, Helpdesk-Tickets mit Zeiterfassung und Verträge",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "bin": {
    "weclapp-mcp": "dist/stdio.js",
    "weclapp-mcp-http": "dist/http.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/http.js",
    "start:stdio": "node dist/stdio.js",
    "dev": "node --watch src/http.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
